<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>App\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\ChargeHub.ico</ApplicationIcon>
    <AssemblyName>ChargeHub</AssemblyName>
    <RootNamespace>ChargeHub</RootNamespace>
    <Version>0.3.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChargeHub.Tests" />
  </ItemGroup>

</Project>
